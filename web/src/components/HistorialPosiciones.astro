---
// Cómo le fue a un equipo en la tabla de posiciones, año por año.
// Cada categoría es un "carril" (Primera arriba) y dentro de él la posición 1 va arriba, así que
// subir o bajar de categoría se ve como un salto entre carriles. Solo años con la categoría cerrada.
import { ORDEN_CATEGORIAS, historialPosiciones, urlPosiciones } from '../lib/datos';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const { filas, anios: aniosCerrados } = historialPosiciones(slug);

// Años a dibujar: los que tienen tabla cerrada, entre la primera y la última aparición del equipo.
const primero = filas.length ? Math.min(...filas.map((f) => f.anio)) : 0;
const ultimo = filas.length ? Math.max(...filas.map((f) => f.anio)) : 0;
const anios = aniosCerrados.filter((a) => a >= primero && a <= ultimo);

// Carriles: solo las categorías en las que jugó, en el orden de las tablas.
const orden = (n: string) => (ORDEN_CATEGORIAS.includes(n) ? ORDEN_CATEGORIAS.indexOf(n) : ORDEN_CATEGORIAS.length);
const nombres = [...new Set(filas.map((f) => f.categoria))].sort((a, b) => orden(a) - orden(b) || a.localeCompare(b, 'es'));

const U = 14;          // alto de una posición
const R = 9;           // radio de la marca
const COL = 54;        // ancho de un año
const IZQ = 92;        // margen para el nombre del carril y las marcas del eje
const ARRIBA = 14;
const ENTRE = 26;      // espacio entre carriles
const ABAJO = 30;      // etiquetas de los años
let y = ARRIBA;
const carriles = nombres.map((nombre) => {
  const total = Math.max(...filas.filter((f) => f.categoria === nombre).map((f) => f.total));
  const c = { nombre, total, top: y, alto: total * U };
  y += c.alto + ENTRE;
  return c;
});
const alto = y - ENTRE + ABAJO;
const ancho = IZQ + anios.length * COL;
const cx = (anio: number) => IZQ + anios.indexOf(anio) * COL + COL / 2;
const cy = (f: { categoria: string; pos: number }) => carriles.find((c) => c.nombre === f.categoria)!.top + (f.pos - 1) * U + U / 2;

const puntos = filas.map((f) => ({ ...f, x: cx(f.anio), y: cy(f) }));
// Segmentos entre años consecutivos (si falta un año, la línea se corta)
const segmentos = puntos.flatMap((p) => {
  const sig = puntos.find((q) => q.anio === anios[anios.indexOf(p.anio) + 1]);
  return sig ? [{ x1: p.x, y1: p.y, x2: sig.x, y2: sig.y }] : [];
});
const texto = (f: (typeof filas)[number]) => `${f.anio}: ${f.pos}.º de ${f.total} en ${f.categoria}${f.pts != null ? ` (${f.pts} pts)` : ''}`;
---
{filas.length > 0 && (
  <section class="hist" aria-labelledby="t-hist-pos">
    <div class="enc">
      <h2 id="t-hist-pos">Posiciones por año</h2>
      <a class="todos" href={urlPosiciones(ultimo)}>Ver la tabla {ultimo} ›</a>
    </div>
    <p class="muted nota">Posición final en cada categoría; arriba es mejor. No incluye el año en curso.</p>

    <div class="scroll" tabindex="0" role="region" aria-label="Gráfico de posiciones por año">
      <svg width={ancho} height={alto} viewBox={`0 0 ${ancho} ${alto}`} role="img"
        aria-label={`Posiciones de ${primero} a ${ultimo}: ${filas.map(texto).join('; ')}`}>
        {carriles.map((c) => (
          <g>
            <rect x={IZQ} y={c.top - 4} width={anios.length * COL} height={c.alto + 8} rx="8" class="carril" />
            <text x="0" y={c.top + c.alto / 2 + 5} class="nombre">{c.nombre}</text>
            <text x={IZQ - 10} y={c.top + U / 2 + 4} class="tick" text-anchor="end">1</text>
            {c.total > 1 && <text x={IZQ - 10} y={c.top + c.alto - U / 2 + 4} class="tick" text-anchor="end">{c.total}</text>}
          </g>
        ))}
        {anios.map((a) => (
          <text x={cx(a)} y={alto - 9} class="anio" text-anchor="middle">{a}</text>
        ))}
        {segmentos.map((s) => <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} class="linea" />)}
        {puntos.map((p) => (
          <g class="marca">
            <title>{texto(p)}</title>
            <circle cx={p.x} cy={p.y} r={R} />
            <text x={p.x} y={p.y + 4} text-anchor="middle" class="num">{p.pos}</text>
          </g>
        ))}
      </svg>
    </div>

    <details class="tabla">
      <summary>Ver como tabla</summary>
      <table>
        <thead><tr><th scope="col">Año</th><th scope="col">Categoría</th><th scope="col">Posición</th><th scope="col">Puntos</th></tr></thead>
        <tbody>
          {[...filas].reverse().map((f) => (
            <tr><td>{f.anio}</td><td>{f.categoria}</td><td>{f.pos}.º de {f.total}</td><td>{f.pts ?? '–'}</td></tr>
          ))}
        </tbody>
      </table>
    </details>
  </section>
)}

<script>
  // En celular el gráfico se desliza de lado: se deja a la vista lo más reciente.
  function alFinal() {
    document.querySelectorAll<HTMLElement>('.hist .scroll').forEach((c) => { c.scrollLeft = c.scrollWidth; });
  }
  document.addEventListener('astro:page-load', alFinal);
</script>

<style>
  .hist { padding-top: 28px; }
  .enc { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .enc h2 { font: 700 24px var(--serif); }
  .todos { font-size: 15px; font-weight: 700; color: var(--accent); text-decoration: none; white-space: nowrap; }
  .nota { margin: 4px 0 12px; font-size: 15px; }
  .scroll {
    overflow-x: auto; padding: 8px 0 4px; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent;
    border: 1.5px solid var(--line); border-radius: 14px; background: var(--surface);
  }
  svg { display: block; max-width: none; }
  .carril { fill: var(--hover); opacity: .55; }
  .nombre { font: 700 14px var(--sans); fill: var(--ink); }
  .tick { font: 400 12px var(--sans); fill: var(--ink-soft); }
  .anio { font: 700 13px var(--sans); fill: var(--ink-soft); }
  .linea { stroke: var(--accent); stroke-width: 2; stroke-linecap: round; }
  .marca circle { fill: var(--accent); stroke: var(--surface); stroke-width: 2; }
  .marca .num { font: 700 12px var(--sans); fill: var(--surface); pointer-events: none; }
  .marca:hover circle { stroke: var(--ink); }
  .tabla { margin-top: 10px; }
  .tabla summary { cursor: pointer; min-height: 40px; display: flex; align-items: center; font-size: 15px; font-weight: 700; color: var(--ink-mid); }
  .tabla table { width: 100%; max-width: 520px; border-collapse: collapse; font-size: 16px; font-variant-numeric: tabular-nums; }
  .tabla th, .tabla td { padding: 8px 10px; text-align: left; border-bottom: 1px solid var(--line); }
  .tabla th { font-size: 14px; color: var(--ink-soft); }
  @media (min-width: 900px) {
    .hist { padding-top: 40px; }
    .enc h2 { font-size: 26px; }
    .scroll { padding: 12px 8px 6px; }
  }
</style>
