---
// Bola roja con el 7 del logo del juego NaNa-ban. Decorativa: el texto del enlace ya lo nombra.
interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
---
<svg class="icono-nanaban" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <circle cx="12" cy="12" r="11.5" fill="#E23B3B" />
  <circle cx="8" cy="7.5" r="3" fill="#fff" fill-opacity="0.35" />
  <polygon points="7,7.5 18,7.5 18,10.5 13.5,18.5 10,18.5 14,11 7,11" fill="#fff" />
</svg>

<style>
  .icono-nanaban { display: inline-block; vertical-align: -0.2em; flex: none; }
</style>
