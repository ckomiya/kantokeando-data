---
// Lista de enlaces agrupada por letra inicial, con atajos A–Z.
import { quitarTildes } from '../lib/datos';

interface Props {
  items: { href: string; nombre: string; meta?: string }[];
}
const { items } = Astro.props;

const inicial = (n: string) => {
  const c = quitarTildes(n.trim()).charAt(0).toUpperCase();
  return /[A-Z]/.test(c) ? c : '#';
};
const grupos = new Map<string, typeof items>();
for (const it of [...items].sort((a, b) => quitarTildes(a.nombre).localeCompare(quitarTildes(b.nombre), 'es', { sensitivity: 'base' }))) {
  const l = inicial(it.nombre);
  if (!grupos.has(l)) grupos.set(l, []);
  grupos.get(l)!.push(it);
}
const letras = [...grupos.keys()];
---
<nav class="letras" aria-label="Ir a la letra">
  {letras.map((l) => <a href={`#letra-${l === '#' ? 'otros' : l}`}>{l}</a>)}
</nav>
{letras.map((l) => (
  <section class="grupo" id={`letra-${l === '#' ? 'otros' : l}`}>
    <h3>{l}</h3>
    <ul>
      {grupos.get(l)!.map((it) => (
        <li><a href={it.href}>{it.nombre}</a>{it.meta && <span class="muted">{it.meta}</span>}</li>
      ))}
    </ul>
  </section>
))}

<style>
  .letras { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 8px; }
  .letras a {
    min-width: 44px; height: 44px; display: grid; place-items: center; border: 1.5px solid var(--line);
    border-radius: 10px; background: var(--surface); font-weight: 700; text-decoration: none;
  }
  .letras a:hover { border-color: var(--ink); }
  .grupo { padding-top: 22px; scroll-margin-top: 12px; }
  h3 { padding-bottom: 6px; border-bottom: 2px solid var(--ink); font: 800 26px var(--serif); color: var(--accent); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: flex; justify-content: space-between; gap: 12px; padding: 12px 2px; border-bottom: 1px solid var(--line-soft); font-size: 17px; }
  li a { text-decoration: none; }
  li a:hover { text-decoration: underline; }
  li .muted { font-size: 15px; white-space: nowrap; }
  @media (min-width: 900px) {
    ul { columns: 3; column-gap: 40px; }
    li { break-inside: avoid; }
  }
</style>
