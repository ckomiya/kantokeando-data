---
// Barra de pestañas móvil. Etiquetas siempre visibles, sin menús escondidos.
import { ultimoAnioConTorneos } from '../lib/datos';

export type Pestana = 'inicio' | 'anio' | 'torneos' | 'posiciones' | 'buscar' | 'ninguna';
interface Props {
  activa?: Pestana;
}
const { activa = 'ninguna' } = Astro.props;

const pestanas: { id: Pestana; texto: string; href: string }[] = [
  { id: 'inicio', texto: 'Inicio', href: '/' },
  { id: 'anio', texto: 'Por año', href: `/anio/${ultimoAnioConTorneos}/` },
  { id: 'torneos', texto: 'Torneos', href: '/torneos/' },
  { id: 'posiciones', texto: 'Posiciones', href: '/posiciones/' },
  { id: 'buscar', texto: 'Buscar', href: '/buscar/' },
];
---
<nav class="tabs" aria-label="Navegación móvil">
  {pestanas.map((p) => (
    <a href={p.href} aria-current={p.id === activa ? 'page' : undefined}>
      <span class="pildora"><span class={`icono icono--${p.id}`} aria-hidden="true"></span></span>
      {p.texto}
    </a>
  ))}
</nav>

<style>
  .tabs {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
    display: grid; grid-template-columns: repeat(5, 1fr);
    padding: 8px 6px max(14px, env(safe-area-inset-bottom));
    background: var(--tab-bg); border-top: 1px solid var(--line);
  }
  a {
    display: flex; flex-direction: column; align-items: center; gap: 4px; min-height: 56px;
    font-size: 14px; font-weight: 700; color: var(--ink); text-decoration: none;
  }
  .pildora { position: relative; width: 60px; height: 32px; border-radius: 16px; display: grid; place-items: center; }
  a[aria-current='page'] .pildora { background: var(--accent-bg); }
  .icono { display: block; border: 2.5px solid var(--ink); }
  .icono--inicio { width: 22px; height: 19px; border: 0; background: var(--ink); clip-path: polygon(50% 0, 100% 48%, 86% 48%, 86% 100%, 14% 100%, 14% 48%, 0 48%); }
  .icono--anio { width: 20px; height: 18px; border-top-width: 6px; border-radius: 3px; }
  .icono--torneos { width: 19px; height: 19px; border-radius: 50%; position: relative; }
  .icono--torneos::after { content: ''; position: absolute; inset: 4px; border-radius: 50%; background: var(--ink); }
  .icono--posiciones { width: 20px; height: 17px; border: 0; background: repeating-linear-gradient(var(--ink) 0 3px, transparent 3px 7px); }
  .icono--buscar { width: 17px; height: 17px; border-radius: 50%; position: relative; margin: -3px -3px 0 0; }
  .icono--buscar::after {
    content: ''; position: absolute; width: 2.5px; height: 8px; background: var(--ink);
    right: -4px; bottom: -7px; transform: rotate(-45deg);
  }
  @media (min-width: 900px) { .tabs { display: none; } }
</style>
