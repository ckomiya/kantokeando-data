---
// Banda delgada de la portada que invita a jugar NaNa-ban (enlace externo a itch.io).
import IconoNanaban from './IconoNanaban.astro';
---
<a class="banda-juego" href="https://ckomiya.itch.io/nana-ban" target="_blank" rel="noopener">
  <IconoNanaban size={32} />
  <span class="texto">
    <span class="titulo">Juega NaNa-ban <span aria-hidden="true">↗</span></span>
    <span class="desc">Gateball retro de 16 bits contra la IA.</span>
  </span>
  <span class="sr-only">(se abre en otra pestaña)</span>
</a>

<style>
  .banda-juego {
    display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 10px 18px;
    background: var(--surface); border: 1.5px solid var(--line); border-radius: 12px;
    color: var(--ink); text-decoration: none;
  }
  .banda-juego:hover { border-color: var(--ink); background: var(--hover); }
  .texto { display: flex; flex-direction: column; min-width: 0; }
  .titulo { font-size: 17px; font-weight: 700; color: var(--accent); }
  .desc { font-size: 15px; line-height: 1.3; color: var(--ink-soft); }
  @media (min-width: 768px) {
    .texto { flex-direction: row; align-items: baseline; gap: 12px; }
  }
</style>
