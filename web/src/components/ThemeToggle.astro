---
// Isla mínima: alterna claro/oscuro y recuerda la elección. Sin elección sigue al sistema.
---
<button type="button" class="tema" data-tema aria-label="Cambiar entre tema claro y oscuro">
  <span class="medio" aria-hidden="true"></span>Tema
</button>

<style>
  .tema {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px;
    border: 1.5px solid var(--line); border-radius: 999px; background: transparent;
    color: var(--ink); font-size: 15px; font-weight: 700; cursor: pointer;
  }
  .tema:hover { border-color: var(--ink); }
  .medio {
    width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--ink);
    background: linear-gradient(90deg, var(--ink) 50%, transparent 50%);
  }
</style>

<script>
  function aplicar(tema: string) {
    document.documentElement.dataset.theme = tema;
    try {
      localStorage.setItem('gd-tema', tema);
    } catch {
      /* sin almacenamiento: el cambio vale solo para esta visita */
    }
  }
  function enlazar() {
    document.querySelectorAll<HTMLButtonElement>('[data-tema]').forEach((b) => {
      if (b.dataset.listo) return;
      b.dataset.listo = '1';
      b.addEventListener('click', () => {
        aplicar(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });
    });
  }
  enlazar();
  document.addEventListener('astro:page-load', enlazar);
</script>
