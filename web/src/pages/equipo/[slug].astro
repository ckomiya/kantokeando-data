---
import Base from '../../layouts/Base.astro';
import Bola from '../../components/Bola.astro';
import MedalleroAnual from '../../components/MedalleroAnual.astro';
import HistorialPosiciones from '../../components/HistorialPosiciones.astro';
import Compartir from '../../components/Compartir.astro';
import ReportarError from '../../components/ReportarError.astro';
import {
  anioPosicionesActual, banderaTorneo, posicionActualDe, comunPorNombre, equipos, etiquetaPuesto, fechaCorta, medalleroPorAnio, nombreCategoria, plural,
  slugify, torneosInternacionales, torneosPorId, ubicacionTorneo, urlComun, urlJugador, urlPosiciones, urlTorneo, type Equipo,
} from '../../lib/datos';

export function getStaticPaths() {
  return equipos.map((e) => ({ params: { slug: e.slug }, props: { equipo: e } }));
}

const { equipo } = Astro.props as { equipo: Equipo };
const partes = equipo.participaciones.filter((p) => p.puesto !== 0); // sin reconocimientos; de la más reciente a la más antigua
const m = equipo.medallas;
const anios = partes.map((p) => p.anio);
const desde = partes.length ? Math.min(...anios) : null;
const hasta = partes.length ? Math.max(...anios) : null;

// Títulos agrupados por torneo "de siempre" (o por nombre propio si no tiene nombre común)
const porTorneo = new Map<string, { nombre: string; href: string | null; n: number; cats: Map<string, number> }>();
for (const p of partes) {
  if (p.puesto !== 1) continue;
  const t = torneosPorId.get(p.torneo)!;
  const clave = t.nombre_comun ?? t.nombre;
  const e = porTorneo.get(clave) ?? { nombre: clave, href: t.nombre_comun && comunPorNombre.has(t.nombre_comun) ? urlComun(t.nombre_comun) : null, n: 0, cats: new Map<string, number>() };
  e.n++;
  const cat = p.categoria ?? 'General';
  e.cats.set(cat, (e.cats.get(cat) ?? 0) + 1);
  porTorneo.set(clave, e);
}
// "Primera ×3 · Segunda": categoría de cada título (de más a menos títulos)
const textoCats = (cats: Map<string, number>) =>
  [...cats].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'es')).map(([c, n]) => (n > 1 ? `${nombreCategoria(c)} ×${n}` : nombreCategoria(c))).join(' · ');
const titulos = [...porTorneo.values()].sort((a, b) => b.n - a.n || a.nombre.localeCompare(b.nombre, 'es'));

// Jugadores que más figuran
const porJugador = new Map<string, { slug: string; nombre: string; n: number }>();
for (const p of partes)
  for (const j of p.jugadores) {
    const e = porJugador.get(j.slug) ?? { ...j, n: 0 };
    e.n++;
    porJugador.set(j.slug, e);
  }
const frecuentes = [...porJugador.values()].sort((a, b) => b.n - a.n || a.nombre.localeCompare(b.nombre, 'es')).slice(0, 12);
const medallero = medalleroPorAnio(partes);
// Solo si el equipo figura en las posiciones actuales (columna Actual del Excel)
const posActual = posicionActualDe(equipo.slug);

// Torneos internacionales: se resaltan arriba y en el historial (igual que en la ficha del jugador)
const intl = partes.filter((p) => torneosInternacionales.has(p.torneo));
const intlTorneos = new Set(intl.map((p) => p.torneo)).size;
const intlPodios = intl.filter((p) => p.puesto !== null && p.puesto <= 3).length;
---
<Base
  titulo={equipo.nombre}
  descripcion={`${equipo.nombre}: ${plural(m['1'], 'título', 'títulos')}, ${m['2']} segundos y ${m['3']} terceros puestos en torneos de gateball del Perú.`}
  seccion="equipos"
  pestana="buscar"
>
  <div class="wrap pagina">
    <a class="volver" href="/equipos/">‹ Equipos</a>

    <section class="hero" aria-label={`Resumen de ${equipo.nombre}`}>
      <div class="ident">
        <p class="etq">Equipo</p>
        <h1>{equipo.nombre}</h1>
        {posActual && (
          <p class="categoria">
            <a href={`${urlPosiciones(anioPosicionesActual)}#cat-${slugify(posActual.categoria)}`}>
              <b>Puesto {posActual.pos}° de {posActual.total}</b>
              <span class="cat">{nombreCategoria(posActual.categoria)} · {anioPosicionesActual}</span>
              {posActual.provisional && <span class="prov">provisional</span>}
            </a>
          </p>
        )}
        <div class="cifra">
          <Bola place={1} size={72} />
          <div><b>{m['1']}</b><span>{m['1'] === 1 ? 'título' : 'títulos'}</span></div>
        </div>
        <p class="otras">
          <span><Bola place={2} size={32} /><b>{m['2']}</b> segundos</span>
          <span><Bola place={3} size={32} /><b>{m['3']}</b> terceros</span>
        </p>
        {desde !== null && <p class="part">{plural(partes.length, 'participación', 'participaciones')} · {desde === hasta ? desde : `${desde}–${hasta}`}</p>}
        {intl.length > 0 && (
          <p class="intl-resumen">
            <span class="tag-int">Internacional</span>
            <b>{plural(intlTorneos, 'torneo internacional', 'torneos internacionales')}</b>
            {intlPodios > 0 && <> · {plural(intlPodios, 'podio', 'podios')}</>}
          </p>
        )}
      </div>
      <div class="vitrina">
        <div class="enc"><h2>Vitrina por año</h2><span>Oro abajo, como base</span></div>
        <MedalleroAnual datos={medallero} tamano={28} />
      </div>
    </section>

    <Compartir mensaje={`${equipo.nombre}: ${plural(m['1'], 'título', 'títulos')} en torneos de gateball del Perú`} />
    <ReportarError tema={`Equipo: ${equipo.nombre}`} />

    {intl.length > 0 && (
      <section class="intl" aria-labelledby="t-intl">
        <div class="enc"><h2 id="t-intl">Torneos internacionales</h2><span class="tag-int">Internacional</span></div>
        <ul>
          {intl.map((p) => (
            <li>
              <Bola place={p.puesto} size={38} />
              <div>
                <p class="label-up">{p.anio} · {etiquetaPuesto(p.puesto)}</p>
                <a href={urlTorneo(p.torneo)}>{p.nombre_torneo}</a>
                {p.categoria && <p class="sub">{nombreCategoria(p.categoria)}</p>}
                <p class="sub donde">{banderaTorneo(p.torneo) && <img class="bandera" src={`/banderas/${banderaTorneo(p.torneo)}.svg`} alt="" width="20" height="15" />}{ubicacionTorneo(p.torneo)}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <HistorialPosiciones slug={equipo.slug} />

    <div class="dos">
      <section aria-labelledby="t-tit">
        <h2 id="t-tit">Títulos por torneo</h2>
        {titulos.length > 0 ? (
          <ul class="titulos">
            {titulos.map((t) => (
              <li>
                <span class="que">
                  {t.href ? <a href={t.href}>{t.nombre}</a> : <span class="nom">{t.nombre}</span>}
                  <small class="cats">{textoCats(t.cats)}</small>
                </span>
                <span class="bolas" aria-hidden="true">
                  {Array.from({ length: Math.min(t.n, 10) }, () => <Bola place={1} size={18} />)}
                </span>
                <b>{t.n}</b>
              </li>
            ))}
          </ul>
        ) : <p class="muted vacio-txt">Aún no tiene primeros puestos registrados.</p>}
      </section>

      <section aria-labelledby="t-jug">
        <h2 id="t-jug">Jugadores frecuentes</h2>
        <p class="muted nota">Veces que figuran en un resultado de {equipo.nombre}.</p>
        <div class="chips">
          {frecuentes.length > 0
            ? frecuentes.map((j) => <a class="chip" href={urlJugador(j.slug)}>{j.nombre}<small>{j.n}</small></a>)
            : <p class="muted">No hay jugadores registrados.</p>}
        </div>
      </section>
    </div>

    <section class="historial" aria-labelledby="t-hist">
      <div class="enc">
        <h2 id="t-hist">Historial por torneo</h2>
        <div class="filtros" role="group" aria-label="Filtrar historial" data-filtros>
          <button type="button" class="chip is-on" data-filtro="todos" aria-pressed="true">Todos</button>
          <button type="button" class="chip" data-filtro="podios" aria-pressed="false">Solo podios</button>
          <button type="button" class="chip" data-filtro="titulos" aria-pressed="false">Solo títulos</button>
          {intl.length > 0 && <button type="button" class="chip" data-filtro="internacional" aria-pressed="false">Internacionales</button>}
        </div>
      </div>
      {partes.map((p) => (
        <div class={`fila${torneosInternacionales.has(p.torneo) ? ' fila--intl' : ''}`} data-puesto={p.puesto ?? 0} data-intl={torneosInternacionales.has(p.torneo) ? '1' : '0'}>
          <span class="puesto"><Bola place={p.puesto} size={40} /><b>{etiquetaPuesto(p.puesto)}</b></span>
          <span class="fecha muted">{fechaCorta(p.fecha)}</span>
          <span class="torneo">
            <a href={urlTorneo(p.torneo)}>{p.nombre_torneo}</a>
            {torneosInternacionales.has(p.torneo) && <> <span class="tag-int">Internacional</span> <span class="donde muted">{banderaTorneo(p.torneo) && <img class="bandera" src={`/banderas/${banderaTorneo(p.torneo)}.svg`} alt="" width="20" height="15" />}{ubicacionTorneo(p.torneo)}</span></>}
            {p.jugadores.length > 0 && (
              <span class="jug">{p.jugadores.map((j, i) => <>{i > 0 && ' · '}<a href={urlJugador(j.slug)}>{j.nombre}</a></>)}</span>
            )}
          </span>
          <span class="cat">{p.categoria ? nombreCategoria(p.categoria) : ''}</span>
          {p.url && <a class="link-fuente" href={p.url} target="_blank" rel="noopener">Artículo ↗</a>}
        </div>
      ))}
      <p class="vacio-filtro muted" data-vacio hidden>No hay participaciones con ese filtro.</p>
    </section>
  </div>
</Base>

<script>
  function enlazar() {
    document.querySelectorAll<HTMLElement>('[data-filtros]').forEach((caja) => {
      if (caja.dataset.listo) return;
      caja.dataset.listo = '1';
      const raiz = caja.closest('.historial')!;
      caja.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filtro]');
        if (!b) return;
        caja.querySelectorAll<HTMLButtonElement>('[data-filtro]').forEach((x) => {
          const on = x === b;
          x.classList.toggle('is-on', on);
          x.setAttribute('aria-pressed', String(on));
        });
        const modo = b.dataset.filtro;
        let visibles = 0;
        raiz.querySelectorAll<HTMLElement>('.fila').forEach((f) => {
          const p = Number(f.dataset.puesto);
          const ok = modo === 'todos' || (modo === 'podios' && p >= 1 && p <= 3) || (modo === 'titulos' && p === 1) || (modo === 'internacional' && f.dataset.intl === '1');
          f.hidden = !ok;
          if (ok) visibles++;
        });
        raiz.querySelector<HTMLElement>('[data-vacio]')!.hidden = visibles > 0;
      });
    });
  }
  enlazar();
  document.addEventListener('astro:page-load', enlazar);
</script>

<style>
  .pagina { padding-top: 4px; padding-bottom: 24px; }
  .volver { display: inline-flex; align-items: center; min-height: 48px; font-size: 16px; font-weight: 700; text-decoration: none; color: var(--ink-soft); }

  /* Tarjeta rectangular verde cancha con franja dorada arriba (sin arco: parecía lápida; sin negro: muy sobrio).
     Se redefinen las variables "invertidas" solo aquí para que las bolas resalten sobre un fondo medio. */
  .hero {
    --inv-bg: var(--faja-4); --inv-soft: #CFE0D5; --inv-line: rgba(255, 255, 255, .24);
    background: var(--inv-bg); color: var(--inv-fg); border: 1.5px solid var(--inv-bg); border-top: 8px solid var(--inv-gold); border-radius: 20px; overflow: hidden; }
  .ident { padding: 26px 20px 24px; text-align: left; }
  .etq { font-size: 14px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--inv-accent); }
  h1 { margin: 6px 0 20px; font: 800 44px/1 var(--serif); }
  .cifra { display: flex; align-items: center; gap: 18px; }
  .cifra b { display: block; font: 800 64px/1 var(--serif); }
  .cifra span { font-size: 18px; }
  .otras { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 12px 26px; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--inv-line); font-size: 17px; }
  .otras span { display: flex; align-items: center; gap: 8px; }
  .part { margin-top: 16px; font-size: 15px; color: var(--inv-soft); }
  .categoria { margin: -8px 0 20px; }
  .categoria a {
    display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; padding: 6px 14px; border-radius: 999px;
    border: 1.5px solid var(--inv-line); color: var(--inv-fg); text-decoration: none;
  }
  .categoria a:hover { border-color: var(--inv-accent); }
  .categoria span { font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--inv-accent); }
  .categoria b { font: 700 18px var(--serif); }
  .categoria .cat { font-size: 16px; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--inv-fg); }
  .categoria .prov { font-size: 13px; font-weight: 400; font-style: italic; letter-spacing: 0; text-transform: none; color: var(--inv-soft); }
  .intl-resumen { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 16px; font-size: 17px; }
  .vitrina { display: none; }

  .intl { margin-top: 20px; padding: 20px 18px 8px; border: 2px solid var(--accent); border-radius: 20px; background: color-mix(in srgb, var(--accent-bg) 55%, transparent); }
  .intl .enc { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
  .intl h2 { font: 700 22px var(--serif); }
  .intl ul { list-style: none; margin: 0; padding: 0; }
  .intl li { display: grid; grid-template-columns: 38px 1fr; gap: 14px; align-items: center; padding: 12px 0; border-top: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); }
  .intl li:first-child { border-top: 0; }
  .intl li a { font: 700 19px/1.25 var(--serif); text-decoration: none; }
  .intl .sub { margin-top: 2px; font-size: 15px; color: var(--ink-mid); }
  .bandera { display: inline-block; vertical-align: -2px; margin-right: 6px; border-radius: 2px; box-shadow: 0 0 0 1px var(--line-strong); }
  .donde { font-size: 16px; }
  .fila--intl { border-left: 4px solid var(--accent); padding-left: 12px; background: color-mix(in srgb, var(--accent-bg) 40%, transparent); }
  .vitrina :global(.inv .raya) { background: rgba(255, 255, 255, .45) !important; }

  h2 { font: 700 24px var(--serif); }
  .dos { display: grid; gap: 8px; }
  .dos section { padding-top: 28px; }
  .nota { margin: 4px 0 12px; font-size: 15px; }
  .titulos { list-style: none; margin: 12px 0 0; padding: 0; }
  .titulos li { display: flex; align-items: center; gap: 10px; padding: 13px 0; border-bottom: 1px solid var(--line); }
  .que { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .titulos a, .titulos .nom { font-size: 17px; line-height: 1.3; text-decoration: none; }
  .cats { font-size: 14px; color: var(--ink-soft); }
  .titulos a:hover { text-decoration: underline; }
  .bolas { display: flex; gap: 3px; }
  .titulos b { min-width: 28px; text-align: right; font: 800 20px var(--serif); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .vacio-txt { margin-top: 12px; }

  .historial { padding-top: 28px; }
  .historial .enc { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .filtros { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0 6px; }
  .filtros .chip { min-height: 40px; padding: 0 14px; font-size: 15px; }
  .fila[hidden] { display: none; }
  .vacio-filtro { padding: 24px 0; }
  .fila { display: grid; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .puesto { display: flex; align-items: center; gap: 10px; font-size: 15px; }
  .fecha { font-size: 15px; }
  .torneo a { font: 700 19px/1.25 var(--serif); text-decoration: none; }
  .jug { display: block; margin-top: 4px; font-size: 15px; color: var(--ink-mid); }
  .jug a { font: 400 15px var(--sans); text-decoration: underline; text-decoration-color: var(--link-line); }
  .cat { font-size: 16px; }
  .fila .link-fuente { justify-self: start; }

  @media (min-width: 900px) {
    .pagina { padding-top: 16px; padding-bottom: 40px; }
    .hero { display: grid; grid-template-columns: 380px minmax(0, 1fr); border-radius: 24px; }
    .ident { padding: 40px; border-right: 1px solid var(--inv-line); }
    h1 { font-size: 56px; margin-bottom: 28px; }
    .cifra b { font-size: 72px; }
    .otras { gap: 12px 28px; margin-top: 24px; }
    .part { margin-top: 24px; font-size: 16px; }
    .vitrina { display: block; min-width: 0; padding: 36px 32px 28px; }
    .vitrina .enc { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; gap: 12px; }
    .vitrina h2 { font-size: 22px; }
    .vitrina .enc span { font-size: 15px; color: var(--inv-soft); }
    .dos { grid-template-columns: 1fr 1fr; gap: 48px; }
    .dos section { padding-top: 40px; }
    h2 { font-size: 26px; }
    .fila {
      grid-template-columns: 150px 110px 1fr 150px 90px; gap: 16px; align-items: center;
      padding: 14px 16px; font-size: 16px;
    }
    .fila:hover { background: var(--hover); }
    .torneo a { font-size: 18px; }
    .fila .link-fuente { justify-self: auto; }
  }
</style>
