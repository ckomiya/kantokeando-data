---
import Base from '../../layouts/Base.astro';
import Bola from '../../components/Bola.astro';
import TarjetaTorneo from '../../components/TarjetaTorneo.astro';
import { comunes, palmares, plural, SIN_CATEGORIA, urlEquipo, type Comun } from '../../lib/datos';

export function getStaticPaths() {
  return comunes.map((c) => ({ params: { comun: c.slug }, props: { comun: c } }));
}

const { comun } = Astro.props as { comun: Comun };
const top = palmares(comun.ediciones, 5);
/** "Libre ×2 · Master70": categorías de los títulos (se omite si no hay categoría). */
const categoriasTexto = (cats: { nombre: string; n: number }[]) =>
  cats.filter((c) => c.nombre !== SIN_CATEGORIA).map((c) => (c.n > 1 ? `${c.nombre} ×${c.n}` : c.nombre)).join(' · ');
const sinEdicion = (() => {
  // años dentro del rango sin edición (ej. 2020)
  const anios = new Set(comun.ediciones.map((t) => t.anio));
  const faltan: number[] = [];
  for (let a = comun.desde; a <= comun.hasta; a++) if (!anios.has(a)) faltan.push(a);
  return faltan;
})();
---
<Base
  titulo={comun.nombre}
  descripcion={`Todas las ediciones de ${comun.nombre} (${comun.desde}–${comun.hasta}) con sus campeones.`}
  seccion="torneos"
  pestana="torneos"
>
  <div class="wrap pagina">
    <a class="volver" href="/torneos/">‹ Todos los torneos</a>
    <p class="eyebrow">Todas las ediciones</p>
    <h1>{comun.nombre}</h1>
    <p class="muted resumen">
      {plural(comun.ediciones.length, 'edición', 'ediciones')} entre {comun.desde} y {comun.hasta}.
      {sinEdicion.length > 0 && ` Sin edición en ${sinEdicion.join(', ')}.`}
    </p>

    {top.length > 0 && (
      <section class="palmares" aria-labelledby="t-palmares">
        <p class="label-up" id="t-palmares">Palmarés</p>
        <h2>Más campeonatos</h2>
        <ol>
          {top.map((p) => (
            <li>
              <span class="quien">
                <a href={urlEquipo(p.equipo.slug)}>{p.equipo.nombre}</a>
                {categoriasTexto(p.categorias) && <small>{categoriasTexto(p.categorias)}</small>}
              </span>
              <span class="bolas" aria-hidden="true">
                {Array.from({ length: Math.min(p.titulos, 8) }, () => <Bola place={1} size={20} />)}
              </span>
              <b>{p.titulos}</b>
            </li>
          ))}
        </ol>
        <p class="nota">Cuenta los primeros puestos de todas las categorías.</p>
      </section>
    )}

    <h2 class="sec">Ediciones</h2>
    <p class="muted sub">De la más reciente a la más antigua.</p>
    <div class="faja"></div>
    <div class="lista">
      {comun.ediciones.map((t) => <TarjetaTorneo torneo={t} tituloAnio conAnio={false} />)}
    </div>
  </div>
</Base>

<style>
  .pagina { padding-top: 8px; padding-bottom: 24px; }
  .volver { display: inline-flex; align-items: center; min-height: 48px; font-size: 16px; font-weight: 700; text-decoration: none; color: var(--ink-soft); }
  h1 { margin-top: 8px; font: 800 34px/1.12 var(--serif); }
  .resumen { margin: 10px 0 22px; font-size: 16px; }

  /* Tarjeta rectangular con franja arriba (sin arco: parecía lápida) */
  .palmares {
    padding: 24px 22px 18px; margin-bottom: 28px; border-radius: 20px; text-align: left;
    background: var(--surface); border: 1.5px solid var(--line-strong); border-top: 8px solid var(--accent);
  }
  .palmares .label-up { color: var(--accent); letter-spacing: .1em; }
  .palmares h2 { margin: 6px 0 14px; font: 700 24px var(--serif); }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: flex; align-items: center; gap: 18px; padding: 14px 4px; border-top: 1px solid var(--line); }
  .quien { flex: 1; min-width: 0; }
  li a { font-size: 18px; font-weight: 700; color: var(--ink); text-decoration: none; }
  .quien small { display: block; margin-top: 4px; font-size: 14px; line-height: 1.35; color: var(--ink-soft); }
  li a:hover { color: var(--accent); }
  .bolas { display: none; flex: none; gap: 4px; }
  li b { flex: none; min-width: 40px; text-align: right; font: 800 22px var(--serif); }
  .nota { margin-top: 12px; font-size: 14px; color: var(--ink-soft); }

  .sec { font: 700 24px var(--serif); }
  .sub { margin: 6px 0 16px; font-size: 15px; }
  .lista { display: grid; gap: 14px; padding-top: 22px; }

  @media (min-width: 480px) {
    .bolas { display: flex; }
  }

  @media (min-width: 900px) {
    .pagina { padding-top: 40px; padding-bottom: 40px; }
    h1 { font-size: 64px; line-height: 1.05; }
    .resumen { font-size: 18px; }
    .palmares { max-width: 640px; padding: 32px 40px 24px; }
    .lista { grid-template-columns: 1fr 1fr; gap: 18px; }
  }
</style>
